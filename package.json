{
  "name": "kudo-check",
  "version": "1.0.0",
  "description": "Static malware analysis for repositories - scans a folder or a GitHub repo, names the malware family it finds, and explains why.",
  "bin": {
    "kudo": "bin/kudo.js",
    "kudo-check": "bin/kudo.js"
  },
  "main": "src/index.js",
  "scripts": {
    "test": "node test/run.js",
    "demo": "node bin/kudo.js --demo stealer"
  },
  "keywords": [
    "malware",
    "scanner",
    "security",
    "antivirus",
    "static-analysis",
    "supply-chain"
  ],
